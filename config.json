{
    "_comment": "手势识别项目配置文件 - 根据平台自动选择合适的配置",
    "common": {
        "dataset": "jester",
        "model_type": "ResNet50",
        "freeze_backbone": false,
        "checkpoint_dir": "checkpoint",
        "optimizer": "adamw",
        "save_every": 10,
        "early_stopping": false,
        "num_frames": 16,
        "hidden_dim": 256,
        "learning_rate": 0.001,
        "weight_decay": 0.001,
        "normalize_mean": [
            0.485,
            0.456,
            0.406
        ],
        "normalize_std": [
            0.229,
            0.224,
            0.225
        ]
    },
    "datasets": {
        "jester": {
            "data_dir": "dataset",
            "num_classes": 27,
            "img_size": [100, 100]
        },
        "ssv2": {
            "data_dir": "dataset/SSv2",
            "num_classes": 174,
            "img_size": [112, 112]
        }
    },
    "windows": {
        "batch_size": 16,
        "num_workers": 6,
        "pin_memory": true,
        "prefetch_factor": 2,
        "num_epochs": 20
    },
    "linux": {
        "batch_size": 64,
        "num_workers": 16,
        "pin_memory": true,
        "prefetch_factor": 4,
        "num_epochs": 50
    }
}