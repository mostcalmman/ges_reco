{
    "_comment": "手势识别项目配置文件 - 根据平台自动选择合适的配置",
    "common": {
        "dataset": "jester",
        "model_type": "LiteResNetGRU_ACSS_New_DTMF",
        "freeze_backbone": false,
        "checkpoint_dir": "checkpoint",
        "optimizer": "adamw",
        "save_every": 10,
        "early_stopping": false,
        "num_frames": 16,
        "hidden_dim": 256,
        "learning_rate": 0.001,
        "weight_decay": 0.001,
        "normalize_mean": [
            0.485,
            0.456,
            0.406
        ],
        "normalize_std": [
            0.229,
            0.224,
            0.225
        ]
    },
    "datasets": {
        "jester": {
            "data_dir": "dataset",
            "num_classes": 27,
            "img_size": [
                100,
                100
            ]
        },
        "ssv2": {
            "data_dir": "dataset/SSv2",
            "num_classes": 174,
            "img_size": [
                112,
                112
            ]
        }
    },
    "windows": {
        "batch_size": 16,
        "num_workers": 6,
        "pin_memory": true,
        "prefetch_factor": 2,
        "num_epochs": 20
    },
    "linux": {
        "batch_size": 64,
        "num_workers": 16,
        "pin_memory": true,
        "prefetch_factor": 8,
        "num_epochs": 50
    },
    "batch_runs": {
        "ssv2_revision": [
            {
                "name": "LightTMF3GRU_112",
                "model_type": "LightTMF3GRU",
                "img_size": 112,
                "review": "R2-2 Micro 低分辨率 / R1-2 原布局 / R1-5 Micro 同设置对照"
            },
            {
                "name": "LightTMF3GRU_SwapPlacement_112",
                "model_type": "LightTMF3GRU_SwapPlacement",
                "img_size": 112,
                "review": "R1-2 Micro 交换布局"
            },
            {
                "name": "LightTMF3GRU_224",
                "model_type": "LightTMF3GRU",
                "img_size": 224,
                "review": "R2-2 Micro 高分辨率"
            },
            {
                "name": "MobileNetV2_ACSSTMF3_112",
                "model_type": "MobileNetV2_ACSSTMF3",
                "img_size": 112,
                "review": "R2-2 Mobile 低分辨率 / R1-5 Mobile 同设置对照"
            },
            {
                "name": "MobileNetV2_ACSSTMF3_224",
                "model_type": "MobileNetV2_ACSSTMF3",
                "img_size": 224,
                "review": "R2-2 Mobile 高分辨率"
            },
            {
                "name": "LightTSMGRU_112",
                "model_type": "LightTSMGRU",
                "img_size": 112,
                "review": "R1-5 Micro TSM"
            },
            {
                "name": "MobileNetV2_TSM_112",
                "model_type": "MobileNetV2_TSM",
                "img_size": 112,
                "review": "R1-5 Mobile TSM"
            },
            {
                "name": "ResNet50_TSM_224_112",
                "model_type": "ResNet50_TSM",
                "img_size": 112,
                "review": "R1-5 Heavy TSM 本应224先用112测"
            },
            {
                "name": "ResNet50_ACSSTMF3_224_112",
                "model_type": "ResNet50_ACSSTMF3",
                "img_size": 112,
                "review": "R2-1 完整模型 / R1-5 Heavy 同设置对照 本应224先用112测"
            },
            {
                "name": "ResNet50_TSN_224_112",
                "model_type": "ResNet50_TSN",
                "img_size": 112,
                "review": "R2-1 无模块基线 本应224先用112测"
            },
            {
                "name": "ResNet50_OnlyACSS_224_112",
                "model_type": "ResNet50_OnlyACSS",
                "img_size": 112,
                "review": "R2-1 仅 ACSS 本应224先用112测"
            },
            {
                "name": "ResNet50_OnlyTMF3_224_112",
                "model_type": "ResNet50_OnlyTMF3",
                "img_size": 112,
                "review": "R2-1 仅 DTMF 本应224先用112测"
            }
        ]
    }
}
